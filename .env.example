# ─── Mode ─────────────────────────────────────────────────────────────────
# demo → no keys needed, deterministic fixtures, simulated delivery/inbound
# live → real LLM, real delivery via Resend, real inbound webhook
APP_MODE=demo

# ─── LLM (live only) ─────────────────────────────────────────────────────
# LLM_PROVIDER=openai            # pick EXACTLY ONE: openai / anthropic / google
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Mail (live only) ─────────────────────────────────────────────────────
# MAIL_PROVIDER=gmail            # gmail (default: one authorised mailbox, shared-mailbox ready) | resend
# Every LIVE send goes to this address instead of the prospect (safety, S3.1):
# DEMO_RECIPIENT_OVERRIDE=            # comma-separated OK; without it LIVE refuses to start unless ALLOW_REAL_OUTREACH=true
# ALLOW_REAL_OUTREACH=true          # ONLY when you truly intend to email real prospects

# Gmail — run `npm run gmail:auth` once to get GMAIL_USER + GMAIL_REFRESH_TOKEN
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=
# GMAIL_USER=you@gmail.com
# GMAIL_REFRESH_TOKEN=
# GMAIL_POLL_SECONDS=10
# MAIL_FROM_NAME=Wayne            # optional display name
# MAIL_REPLY_TO=sales@company.com # optional: a Google Group so the whole team gets replies

# Resend (alternative: transactional service + inbound webhook)
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=whsec_...
# SENDER_ADDRESS=bd@yourdomain.com

# ─── Discovery sources (live only) ───────────────────────────────────────
# SEARCH_API_KEY=tvly-...          # Tavily; optional
# GITHUB_TOKEN=ghp_...             # optional, raises GitHub rate limits
# PIPELINE_BATCH=8                 # leads researched per pipeline run

# ─── Database (live only; demo reads fixtures/demo/dataset.json) ─────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
